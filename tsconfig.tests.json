{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "plugins": [],
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/tests/**/*.ts",
    "src/tests/**/*.tsx",
    "e2e/**/*.ts",
    "playwright.config.ts",
    "vitest.config.mts"
  ],
  "exclude": ["node_modules"]
}
